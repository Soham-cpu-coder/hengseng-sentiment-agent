# CrowdWisdom Trading - HengSeng Sentiment Agent Environment Variables
# Copy this file to .env and insert your real tokens to run against live APIs.

# Apify API Token (https://console.apify.com/account/integrations)
APIFY_API_KEY=your_apify_api_token_here

# Exa.com API Key (https://dashboard.exa.ai/)
EXA_API_KEY=your_exa_api_key_here

# Optional: Tavily API Key for secondary news search fallback
TAVILY_API_KEY=your_tavily_api_key_here

# Apify Actor IDs for Scraping (verified production actors from Apify Store)
APIFY_ACTOR_TELEGRAM=tri_angle~telegram-scraper
APIFY_ACTOR_LIHKG=claude_code_reviewer~lihkg-scraper
APIFY_ACTOR_NAVER=hgservices~naver-stock-discussion-scraper
APIFY_ACTOR_AASTOCKS=bovi~aastocks-scraper
APIFY_ACTOR_FUTU=apify~web-scraper
